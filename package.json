{
  "name": "pulsedl",
  "version": "0.2.0",
  "description": "Electron frontend for yt-dlp",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "dev": "npm run start",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never"
  },
  "build": {
    "appId": "com.pulsedl.app",
    "productName": "PulseDL",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "templates/**/*",
      "static/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Utility",
      "synopsis": "Electron frontend for yt-dlp",
      "target": [
        "AppImage",
        "deb"
      ],
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "electron": "^41.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3"
  },
  "author": {
    "name": "PulseDL",
    "email": "contact@pulsedl.local"
  },
  "desktopName": "PulseDL"
}
